# Where2Eat configuration
#
# Leave these unset to run in DEMO MODE: the app serves fixture restaurants
# around the computed midpoint and renders a schematic map instead of Google's.
# Everything else — sessions, links, seats, midpoint maths — behaves identically.

# Server-side key. Used for Places Nearby Search, Place Details, Geocoding and
# Places Autocomplete. Never sent to the browser.
# Restrict to: Places API (New), Geocoding API.
GOOGLE_MAPS_SERVER_KEY=

# Browser key. Used only to load the Google Maps JavaScript API.
# Restrict by HTTP referrer to your own domain(s).
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=

# Optional: public origin used when building shareable links.
# Falls back to the request's own host when unset.
NEXT_PUBLIC_APP_ORIGIN=
